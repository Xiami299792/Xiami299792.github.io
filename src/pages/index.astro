---
// 首页专用：People's Platform (Block & Bold) 海报风
// 字体与 poster.css 已在 BaseLayout 里引入，这里不再重复
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SERIES, SITE, TECH_SECTIONS } from '../consts';
import { getPostsByCategory, getSeriesOverview, groupByTechSection, postPath } from '../utils/posts';
import { withBase } from '../utils/url';

const HOME_LIMIT = 5;

const [tech, essay, study, seriesOverview] = await Promise.all([
  getPostsByCategory('tech'),
  getPostsByCategory('essay'),
  getPostsByCategory('study'),
  getSeriesOverview(),
]);

const featured = seriesOverview[0];
const featuredInfo = featured ? SERIES[featured.key as keyof typeof SERIES] : undefined;

// 三个大板块 = 首页里的三个模块（01 技术 / 02 随笔 / 03 伴学）
const modules = [
  { cat: CATEGORIES.tech, groups: groupByTechSection(tech) },
  { cat: CATEGORIES.essay, groups: [{ key: null, posts: essay }] },
  { cat: CATEGORIES.study, groups: [{ key: null, posts: study }] },
]
  .map((m) => ({
    ...m,
    total: m.groups.reduce((n, g) => n + g.posts.length, 0),
    shown: m.groups.reduce((n, g) => n + Math.min(g.posts.length, HOME_LIMIT), 0),
  }))
  .filter((m) => m.total > 0);
---

<BaseLayout wide description={SITE.description}>
  <div class="poster">
    <header class="masthead">
      <p class="kicker">Science &amp; Culture · Since 2026</p>
      <h1>{SITE.title}</h1>
      <p class="lede">{SITE.description}</p>
    </header>

    {
      featured && featuredInfo && (
        <section class="spotlight">
          <p class="spotlight__kicker">系列连载 · Series</p>
          <a class="spotlight__title" href={withBase(`/series/${featured.key}/`)}>
            {featuredInfo.title}
          </a>
          <p class="spotlight__sub">
            {[featuredInfo.subtitle, `共 ${featured.posts.length} 篇`].filter(Boolean).join(' · ')}
          </p>
          <ol class="spotlight__list">
            {featured.posts.map((post, i) => (
              <li>
                <a href={withBase(postPath(post))}>
                  <span class="spotlight__num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <div class="modules">
      {
        modules.map(({ cat, groups, total, shown }, i) => (
          <section class="module">
            <div class="module__head">
              <span class="module__num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="module__title">{cat.label}</h2>
              <span class="module__count">{total} 篇</span>
            </div>

            {groups.map((group) => (
              <>
                {group.key && (
                  <div class="subhead">
                    <h3>{TECH_SECTIONS[group.key].label}</h3>
                    <em>{group.posts.length} 篇</em>
                  </div>
                )}
                <div class="post-list">
                  {group.posts.slice(0, HOME_LIMIT).map((post) => (
                    <PostCard post={post} />
                  ))}
                </div>
              </>
            ))}

            {total > shown && (
              <a class="section-more" href={withBase(`/category/${cat.key}/`)}>
                查看全部 {total} 篇 →
              </a>
            )}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
