---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SERIES, SITE, TECH_SECTIONS } from '../consts';
import { getPostsByCategory, getSeriesOverview, groupByTechSection, postPath } from '../utils/posts';
import { withBase } from '../utils/url';

const HOME_LIMIT = 5;

const [tech, essay, seriesOverview] = await Promise.all([
  getPostsByCategory('tech'),
  getPostsByCategory('essay'),
  getSeriesOverview(),
]);

const featured = seriesOverview[0];
const featuredInfo = featured ? SERIES[featured.key as keyof typeof SERIES] : undefined;

// 首页做成「两本刊物并列」：技术（深色 Broadside）与生活随笔（铅字报刊）。
// 技术下再按板块分成软科普 / 硬指南，各成一组，不混在一起。
const techGroups = groupByTechSection(tech);
const boards = [
  { cat: CATEGORIES.tech, groups: techGroups },
  { cat: CATEGORIES.essay, groups: [{ key: null, posts: essay }] },
].filter((b) => b.groups.some((g) => g.posts.length > 0));
---

<BaseLayout wide description={SITE.description}>
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p>{SITE.description}</p>
  </section>

  {
    featured && featuredInfo && (
      <section class="section section--series">
        <div class="section-head">
          <h2 class="section-title">
            <span class="dot" />
            系列连载
          </h2>
          <a class="section-more" href={withBase('/series/')}>
            全部系列 →
          </a>
        </div>

        <div class="series-strip">
          <div class="series-strip__head">
            <a class="series-strip__title" href={withBase(`/series/${featured.key}/`)}>
              {featuredInfo.title}
            </a>
            <p class="series-strip__sub">{featuredInfo.subtitle}</p>
            <p class="series-strip__desc">{featuredInfo.description}</p>
            <p class="series-strip__meta">
              共 {featured.posts.length} 篇 · {featuredInfo.author}
            </p>
          </div>
          <ol class="series-strip__list">
            {featured.posts.map((post, i) => (
              <li>
                <a href={withBase(postPath(post))}>
                  <span class="series-strip__num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    boards.map(({ cat, groups }) => {
      const total = groups.reduce((n, g) => n + g.posts.length, 0);
      return (
        <section class="pub" data-cat={cat.key}>
          <div class="section-head">
            <h2 class="section-title">
              <span class="dot" />
              {cat.label}
            </h2>
            <a class="section-more" href={withBase(`/category/${cat.key}/`)}>
              共 {total} 篇 →
            </a>
          </div>

          {groups.map((group) => (
            <div class="board">
              {group.key && (
                <div class="subhead">
                  <h3>{TECH_SECTIONS[group.key].label}</h3>
                  <span>{TECH_SECTIONS[group.key].hint}</span>
                  <em>{group.posts.length} 篇</em>
                </div>
              )}
              <div class="post-list">
                {group.posts.slice(0, HOME_LIMIT).map((post) => (
                  <PostCard post={post} />
                ))}
                {group.posts.length > HOME_LIMIT && (
                  <a
                    class="section-more"
                    style="display:inline-block;padding:14px 0"
                    href={withBase(`/category/${cat.key}/`)}
                  >
                    查看全部 {group.posts.length} 篇 →
                  </a>
                )}
              </div>
            </div>
          ))}
        </section>
      );
    })
  }
</BaseLayout>
