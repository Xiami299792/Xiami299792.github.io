---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';
import { getPostsByCategory } from '../../utils/posts';

export async function getStaticPaths() {
  return (Object.keys(CATEGORIES) as CategoryKey[]).map((key) => ({
    params: { category: key },
    props: { key },
  }));
}

const { key } = Astro.props;
const cat = CATEGORIES[key];
const posts = await getPostsByCategory(key);
---

<BaseLayout title={cat.label} description={cat.description}>
  <h1 class="page-title">{cat.emoji} {cat.label}</h1>
  <p class="page-lead">{cat.description} 共 {posts.length} 篇。</p>

  {posts.length === 0 ? (
    <p class="empty">这个分类下还没有文章。</p>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )}
</BaseLayout>
