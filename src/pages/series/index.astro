---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERIES, type SeriesKey } from '../../consts';
import { getSeriesPosts, postPath } from '../../utils/posts';
import { withBase } from '../../utils/url';

const overview = [];
for (const key of Object.keys(SERIES) as SeriesKey[]) {
  const posts = await getSeriesPosts(key);
  if (posts.length > 0) overview.push({ key, posts });
}
---

<BaseLayout wide title="系列" description="按系列成组阅读的长文">
  <h1 class="page-title">系列</h1>
  <p class="page-lead">
    {overview.length} 个系列，共 {overview.reduce((n, s) => n + s.posts.length, 0)} 篇。
  </p>

  {
    overview.length === 0 ? (
      <p class="empty">还没有系列文章。</p>
    ) : (
      overview.map(({ key, posts }) => (
        <section class="series-card">
          <h2 class="series-card__title">
            <a href={withBase(`/series/${key}/`)}>{SERIES[key].title}</a>
          </h2>
          <p class="series-card__desc">{SERIES[key].description}</p>
          <p class="series-card__meta">{posts.length} 篇</p>
          <ol class="series-card__list">
            {posts.slice(0, 4).map((post) => (
              <li>
                <a href={withBase(postPath(post))}>{post.data.title}</a>
              </li>
            ))}
            {posts.length > 4 && (
              <li class="muted">
                <a href={withBase(`/series/${key}/`)}>…… 还有 {posts.length - 4} 篇</a>
              </li>
            )}
          </ol>
        </section>
      ))
    )
  }
</BaseLayout>
