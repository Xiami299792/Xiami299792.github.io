---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, SERIES, type SeriesKey } from '../../consts';
import { getPublishedPosts, getSeriesPosts, postPath, seriesParts } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const keys = Object.keys(SERIES) as SeriesKey[];
  const result = [];

  for (const key of keys) {
    const posts = await getSeriesPosts(key);
    // 系列里一篇文章都没有就跳过；草稿只在开发模式可见
    if (posts.length === 0) continue;
    result.push({
      params: { series: key },
      props: { key, posts, parts: seriesParts(posts) },
    });
  }

  return result;
}

const { key, posts, parts } = Astro.props;
const info = SERIES[key as SeriesKey];
const grouped = parts.length > 0;
// 有分部的系列按分部分组；没归入任何分部的文章（比如「写在前面」）也要出现在目录里，
// 否则只要有文章带 part，没带 part 的那几篇就会从目录页上静默消失
const hasUngrouped = posts.some((p) => !p.data.part);
const buckets = grouped ? [...(hasUngrouped ? [''] : []), ...parts] : [''];

// 整个系列都是同一个分类时，每行都标一遍是纯噪音
const mixedCategories = new Set(posts.map((p) => p.data.category)).size > 1;

function groupOf(post: (typeof posts)[number]) {
  return post.data.part ?? '';
}
---

<BaseLayout wide title={info.title} description={info.description}>
  <h1 class="page-title">{info.title}</h1>
  <p class="page-lead">{[info.subtitle, `共 ${posts.length} 篇`].filter(Boolean).join(' · ')}</p>

  {
    (info.description || info.note) && (
      <div class="series-intro">
        {info.description && <p>{info.description}</p>}
        {info.note && <p class="series-intro__meta">{info.note}</p>}
      </div>
    )
  }

  {
    buckets.map((part) => {
      const items = grouped ? posts.filter((p) => groupOf(p) === part) : posts;
      return (
        <section>
          {part && <h2 class="archive-year">{part}</h2>}
          <ol class="series-list">
            {items.map((post) => {
              const n = posts.indexOf(post) + 1;
              return (
                <li class="series-list__item">
                  <a href={withBase(postPath(post))}>
                    <span class="series-list__num">{String(n).padStart(2, '0')}</span>
                    <span class="series-list__body">
                      <span class="series-list__title">{post.data.title}</span>
                      {post.data.summary && (
                        <span class="series-list__summary">{post.data.summary}</span>
                      )}
                    </span>
                    {mixedCategories && (
                      <span class={`cat cat--${CATEGORIES[post.data.category].key}`}>
                        {CATEGORIES[post.data.category].label}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })
  }
</BaseLayout>
