---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 正文在 src/content/pages/about.md —— 改内容不用碰这个文件。
// 注意：兼容模式下 entry.id 会带 .md 后缀（跟文章 URL 那个坑同源），
// 所以这里按去后缀的方式找，不写死 id。
const entries = await getCollection('pages');
const entry =
  entries.find((e) => e.id.replace(/\.mdx?$/i, '') === 'about') ?? entries[0];

if (!entry) {
  throw new Error('缺少 src/content/pages/about.md');
}

const { Content } = await render(entry);
const title = entry.data.title ?? '关于';
---

<BaseLayout title={title} description="关于这个博客和它的作者">
  <h1 class="page-title">{title}</h1>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>
