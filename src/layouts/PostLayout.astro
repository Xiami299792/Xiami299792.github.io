---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
import { CATEGORIES } from '../consts';
import { formatDate, postPath, postSlug, type Post } from '../utils/posts';
import { withBase } from '../utils/url';

interface SeriesInfo {
  title: string;
  subtitle: string;
  description: string;
  author: string;
  note: string;
}

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
  /** 更早的一篇（全站范围） */
  older?: Post;
  /** 更新的一篇（全站范围） */
  newer?: Post;
  /** 所属系列 */
  seriesKey?: string;
  seriesInfo?: SeriesInfo;
  seriesIndex?: number;
  seriesTotal?: number;
  seriesPrev?: Post;
  seriesNext?: Post;
}

const {
  post,
  headings,
  older,
  newer,
  seriesKey,
  seriesInfo,
  seriesIndex = 0,
  seriesTotal = 0,
  seriesPrev,
  seriesNext,
} = Astro.props;

const cat = CATEGORIES[post.data.category];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const inSeries = Boolean(seriesKey && seriesInfo);
const seriesUrl = seriesKey ? withBase(`/series/${seriesKey}/`) : '';

// 随笔页的明朝体：按页裁剪的子集（scripts/build-fonts.mjs 生成，文件名 = slug 里的 / 换成 -）。
// 只有随笔分类用这个字体，技术栏目用中性无衬线主题。
const fontFile =
  post.data.category === 'essay'
    ? withBase(`/fonts/huiwen-${postSlug(post).replace(/\//g, '-')}.woff2`)
    : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  type="article"
  image={post.data.cover}
  cat={post.data.category}
  font={fontFile}
>
  <article data-pagefind-body>
    <header class="post-header">
      <div class="post-meta">
        <a class={`cat cat--${cat.key}`} href={withBase(`/category/${cat.key}/`)}>
          {cat.label}
        </a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {
          post.data.updated && (
            <>
              <span class="sep">/</span>
              <span>更新于 {formatDate(post.data.updated)}</span>
            </>
          )
        }
        {post.data.draft && <span class="draft-tag">草稿</span>}
      </div>

      <h1>{post.data.title}</h1>

      {/* 导语 / 报纸的 deck：两个分类主题都把它做成标题区的第二层 */}
      {post.data.summary && <p class="post-deck">{post.data.summary}</p>}

      {
        post.data.tags.length > 0 && (
          <div class="post-tags">
            {/* 标签页已移除，这里只作展示，不再是链接 */}
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      inSeries && (
        <aside class="series-banner">
          <div class="series-banner__main">
            <span class="series-banner__label">系列</span>
            <a class="series-banner__title" href={seriesUrl}>
              {seriesInfo!.title}
            </a>
            <span class="series-banner__count">
              第 {seriesIndex + 1} / {seriesTotal} 篇
            </span>
          </div>
          <a class="series-banner__link" href={seriesUrl}>
            目录 →
          </a>
        </aside>
      )
    }

    {
      toc.length > 2 && (
        <details class="toc" open={toc.length <= 14}>
          <summary class="toc-title">本文目录（{toc.length} 节）</summary>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'depth-3' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      inSeries ? (
        <nav class="post-nav" aria-label="系列导航">
          {seriesPrev ? (
            <a href={withBase(postPath(seriesPrev))}>
              <span class="dir">← 上一篇（{seriesIndex}/{seriesTotal}）</span>
              <span class="title">{seriesPrev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {seriesNext ? (
            <a class="next" href={withBase(postPath(seriesNext))}>
              <span class="dir">
                下一篇（{seriesIndex + 2}/{seriesTotal}） →
              </span>
              <span class="title">{seriesNext.data.title}</span>
            </a>
          ) : (
            <a class="next" href={seriesUrl}>
              <span class="dir">已经是最后一篇 →</span>
              <span class="title">回到系列目录</span>
            </a>
          )}
        </nav>
      ) : (
        <nav class="post-nav" aria-label="文章导航">
          {newer ? (
            <a href={withBase(postPath(newer))}>
              <span class="dir">← 更新的一篇</span>
              <span class="title">{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {older ? (
            <a class="next" href={withBase(postPath(older))}>
              <span class="dir">更早的一篇 →</span>
              <span class="title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <Giscus />
  </article>
</BaseLayout>
