---
// 自托管字体（@fontsource 把 woff2 打进产物，不走 Google Fonts CDN，
// 国内访问不会因为 fonts.googleapis.com 被墙而卡住）
// 只引 latin 子集：中文字形交给系统字体，避免加载几 MB 的 CJK 字体
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
// Broadside 的西文字体（技术分类用）
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow/latin-900.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
// People's Platform 的西文字体（首页与各栏目页用）
import '@fontsource/alfa-slab-one/latin-400.css';
import '@fontsource/archivo-narrow/latin-400.css';
import '@fontsource/archivo-narrow/latin-500.css';
import '@fontsource/archivo-narrow/latin-600.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';

import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/cat-essay.css';
import '../styles/cat-tech.css';
// 海报风：站点外壳 + 栏目页。内部全部限定在 :root:not([data-cat])，
// 有分类主题的文章页不会被它覆盖。
import '../styles/poster.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  /** 列表页用较宽的栏；文章页保持阅读栏宽 */
  wide?: boolean;
  /**
   * 分类主题。设了就在 <html> 上打 data-cat，
   * 由 cat-essay.css / cat-tech.css 整套换皮（随笔=铅字报刊，技术=Broadside）。
   * 不设则用 global.css 的中性主题。
   */
  cat?: 'essay' | 'tech';
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image,
  wide = false,
  cat,
} = Astro.props;

// 首页的 <title> 只用站点名 —— 站名本身已经是一句话，
// 再拼副标题会变成「新世界 · 科学与文化 · 科学与文化」。
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const ogImage = image ? new URL(image, Astro.site ?? 'https://example.com').href : undefined;
---

<!doctype html>
<html lang={SITE.lang} data-theme="light" data-cat={cat}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={`${import.meta.env.BASE_URL}rss.xml`}
    />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {/* 在渲染前定好主题，避免深色模式下的白屏闪烁 */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <Header />
    <main>
      <div class:list={['container', { 'container--narrow': !wide }]}>
        <slot />
      </div>
    </main>
    <Footer />

    <script>
      // 图标由 CSS 根据 data-theme 切换，这里只负责翻转和记住选择
      const toggle = document.getElementById('theme-toggle');

      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* 隐私模式下 localStorage 可能不可用，忽略即可 */
        }
      });
    </script>
  </body>
</html>
