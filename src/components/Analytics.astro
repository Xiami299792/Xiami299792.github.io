---
/**
 * 访问统计埋点（51.LA v6）。
 *
 * 只在正式构建（astro build / astro preview）里输出，`astro dev` 不加载 ——
 * 本地预览的次数不该混进真实数据里。
 * consts.ts 里的 ANALYTICS.la.id 留空则整块不输出，等于没装。
 *
 * 如果 51.LA 后台给你的代码跟下面不一样（他们的代码样式改过几版），
 * 把官方那段整段贴进下面「官方代码区」，其余文件都不用动。
 */
import { ANALYTICS } from '../consts';

const { id, ck } = ANALYTICS.la;
const enabled = import.meta.env.PROD && id !== '';
---

{
  enabled && (
    <>
      {/* 官方代码区 —— 51.LA「应用管理」页面拿到的两行，autoTrack 照抄官方给的值 */}
      <script
        is:inline
        charset="UTF-8"
        id="LA_COLLECT"
        src="https://sdk.51.la/js-sdk-pro.min.js"
      />
      <script
        is:inline
        set:html={`LA.init({id:${JSON.stringify(id)},ck:${JSON.stringify(ck)},autoTrack:true})`}
      />
    </>
  )
}
