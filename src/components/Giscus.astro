---
import { GISCUS } from '../consts';

interface Props {
  /** 评论框配色，跟随所在页面的配色，不再跟系统日夜走 */
  theme?: string;
}

const { theme = 'light' } = Astro.props;

// 全站只有一套纸面配色（日夜切换那个提交已经拆掉了），
// 所以评论框固定走 light，不要交给 preferred_color_scheme —— 那会让
// 系统偏好深色的读者看到一个深色评论框，跟纸面正文割裂。

// 四项都齐了才渲染。缺任意一项就整块不出现 ——
// 访客不该看到「评论尚未启用」这种半成品提示。
const ready =
  GISCUS.enabled &&
  GISCUS.repo !== '' &&
  GISCUS.repoId !== '' &&
  GISCUS.categoryId !== '';
---

{
  ready && (
    <section class="comments" aria-label="评论">
      <h2 class="section-title comments-label">
        <span class="dot" />
        评论
      </h2>

      <div id="giscus-container">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping={GISCUS.mapping}
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme={theme}
          data-lang={GISCUS.lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    </section>
  )
}
