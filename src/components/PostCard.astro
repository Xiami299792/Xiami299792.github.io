---
import { CATEGORIES, SERIES } from '../consts';
import { formatDate, postPath, readingTime, type Post } from '../utils/posts';
import { withBase } from '../utils/url';

interface Props {
  post: Post;
  /** 是否显示分类（首页分栏时不需要，归档/标签/系列页需要） */
  showCategory?: boolean;
  /**
   * 是否显示日期/时长那一行。随笔的标题本身就是日期（如「9月20日」），
   * 再挂一行 2026-09-20 就是同一件事说两遍，所以首页的随笔列表传 false。
   */
  showMeta?: boolean;
}

const { post, showCategory = false, showMeta = true } = Astro.props;
const cat = CATEGORIES[post.data.category];
const rt = readingTime(post.body);

const seriesKey = post.data.series as keyof typeof SERIES | undefined;
const series = seriesKey ? SERIES[seriesKey] : undefined;

/* 只写「系列 · 第 N 篇」时，两条不同系列的「第一课」在分类页和归档里长得一模一样，
   而系列名只挂在 title 上——手机没有悬停，所以这里把系列名写出来。
   标题里已经有序号的（「第 6 章 …」「第一课」）就不再重复一遍：
   DSH 那个系列的 order 把「前言」也算进去，标出来会和标题里的章号对不上（第 6 章 / 第 7 篇）。 */
const titleHasNumber = /第\s*[0-9一二三四五六七八九十]+\s*[章节篇课]/.test(post.data.title);
const seriesLabel = series
  ? titleHasNumber
    ? series.shortTitle
    : `${series.shortTitle} · 第 ${post.data.order ?? '?'} ${series.unit}`
  : undefined;
---

<a class="post-card" href={withBase(postPath(post))}>
  <h3>{post.data.title}</h3>

  {
    showMeta && (
      <div class="post-meta">
        {showCategory && <span class={`cat cat--${cat.key}`}>{cat.label}</span>}
        {seriesLabel && <span class="series-tag">{seriesLabel}</span>}
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {rt && (
          <>
            <span class="sep">/</span>
            <span>{rt}</span>
          </>
        )}
        {post.data.updated && (
          <>
            <span class="sep">/</span>
            <span>已更新</span>
          </>
        )}
        {post.data.draft && <span class="draft-tag">草稿</span>}
      </div>
    )
  }

  {post.data.summary && <p>{post.data.summary}</p>}
</a>
